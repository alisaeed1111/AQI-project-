# ── Copy this file to ".env" and fill in your key ─────────────────────
# Get a FREE key at: https://home.openweathermap.org/api_keys
# (The project runs on realistic SAMPLE data even without a key,
#  so you can see everything working first, then switch to live data.)

OPENWEATHER_API_KEY=

# Optional: override the city (defaults to Karachi).
# CITY_NAME=Karachi
# CITY_LAT=24.8607
# CITY_LON=67.0011

# Data source mode: "auto" (use API if key present, else sample),
# "sample" (always synthetic), or "api" (force live API).
DATA_MODE=auto
